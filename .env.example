# Copy to .env for docker-compose (never commit .env). Every entry is optional except
# SEC_USER_AGENT when the filings or fundamentals jobs run.
SEC_USER_AGENT=my-investment-app you@example.com
FRED_API_KEY=
# The Firebase service-account JSON as one line, or leave empty and mount the key file.
FIREBASE_CREDENTIALS_JSON=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
